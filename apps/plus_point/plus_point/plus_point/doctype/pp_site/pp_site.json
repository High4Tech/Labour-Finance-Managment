{
  "doctype": "DocType",
  "name": "PP Site",
  "module": "PLUS POINT",
  "custom": 0,
  "autoname": "hash",
  "title_field": "site_name",
  "description": "A work location under ERPNext Project",
  "track_changes": 1,
  "allow_import": 1,
  "engine": "InnoDB",
  "is_submittable": 0,
  "field_order": [
    "site_name",
    "project",
    "site_type",
    "parent_site",
    "country",
    "state",
    "city",
    "address_line1",
    "address_line2",
    "postal_code",
    "latitude",
    "longitude",
    "address",
    "is_active"
  ],
  "fields": [
    {
      "fieldname": "site_name",
      "fieldtype": "Data",
      "label": "Site Name",
      "reqd": 1,
      "in_list_view": 1,
      "description": "A recognizable venue name, such as Riyadh Convention Centre."
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "options": "Project",
      "reqd": 1,
      "in_list_view": 1,
      "description": "The client job this location belongs to. A project can contain several work sites."
    },
    {
      "fieldname": "site_type",
      "fieldtype": "Select",
      "label": "Site Type",
      "options": "Main Site\nCompound\nWarehouse\nOther",
      "default": "Main Site",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "parent_site",
      "fieldtype": "Link",
      "label": "Parent Site",
      "options": "PP Site",
      "description": "Optional: place a compound or warehouse under a main site from the same project."
    },
    {
      "fieldname": "address",
      "fieldtype": "Small Text",
      "label": "Formatted address",
      "read_only": 1
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1,
      "description": "Only active sites can be used to prepare daily attendance."
    },
    {
      "fieldname": "country",
      "fieldtype": "Link",
      "label": "Country",
      "options": "Country",
      "in_standard_filter": 1
    },
    {
      "fieldname": "state",
      "fieldtype": "Data",
      "label": "State / region"
    },
    {
      "fieldname": "city",
      "fieldtype": "Data",
      "label": "City",
      "in_standard_filter": 1
    },
    {
      "fieldname": "address_line1",
      "fieldtype": "Data",
      "label": "Street address"
    },
    {
      "fieldname": "address_line2",
      "fieldtype": "Data",
      "label": "Building / additional directions"
    },
    {
      "fieldname": "postal_code",
      "fieldtype": "Data",
      "label": "Postal code"
    },
    {
      "fieldname": "latitude",
      "fieldtype": "Data",
      "label": "Latitude"
    },
    {
      "fieldname": "longitude",
      "fieldtype": "Data",
      "label": "Longitude"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 0,
      "share": 0
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "show_title_field_in_link": 1
}
