{
  "doctype": "DocType",
  "name": "PP Site",
  "module": "PLUS POINT",
  "custom": 0,
  "autoname": "hash",
  "title_field": "site_name",
  "description": "A work location under ERPNext Project",
  "track_changes": 1,
  "allow_import": 1,
  "engine": "InnoDB",
  "is_submittable": 0,
  "field_order": [
    "site_name",
    "project",
    "site_type",
    "parent_site",
    "address",
    "is_active"
  ],
  "fields": [
    {
      "fieldname": "site_name",
      "fieldtype": "Data",
      "label": "Site Name",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Use a recognizable location name, such as DHA Phase 6 construction site."
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "options": "Project",
      "reqd": 1,
      "in_list_view": 1,
      "description": "The client job this location belongs to. A project can contain several work sites."
    },
    {
      "fieldname": "site_type",
      "fieldtype": "Select",
      "label": "Site Type",
      "options": "Main Site\nCompound\nWarehouse\nOther",
      "default": "Main Site",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "parent_site",
      "fieldtype": "Link",
      "label": "Parent Site",
      "options": "PP Site",
      "description": "Optional: place a compound or warehouse under a main site from the same project."
    },
    {
      "fieldname": "address",
      "fieldtype": "Small Text",
      "label": "Address"
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "in_list_view": 1,
      "description": "Only active sites can be used to prepare daily attendance."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 0,
      "share": 0
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
