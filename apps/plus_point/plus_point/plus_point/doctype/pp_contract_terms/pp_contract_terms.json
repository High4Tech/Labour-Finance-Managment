{
  "doctype": "DocType",
  "name": "PP Contract Terms",
  "module": "PLUS POINT",
  "custom": 0,
  "autoname": "hash",
  "title_field": "agreement_title",
  "description": "ERPNext contract + project billing policy (not a replacement contract)",
  "track_changes": 1,
  "allow_import": 1,
  "engine": "InnoDB",
  "is_submittable": 0,
  "field_order": [
    "agreement_title",
    "contract",
    "project",
    "billing_model",
    "currency",
    "fixed_amount",
    "status",
    "effective_start",
    "effective_end",
    "staffing",
    "billing_item",
    "auto_invoice",
    "validity_mode",
    "resource_mode",
    "rate_card",
    "event_basis",
    "governing_agreement",
    "commercial_status",
    "commercial_source",
    "recurrence_note",
    "commercial_snapshot"
  ],
  "fields": [
    {
      "fieldname": "contract",
      "fieldtype": "Link",
      "label": "Client contract",
      "options": "Contract",
      "reqd": 1,
      "in_list_view": 1,
      "description": "The existing client agreement. Keep the signed agreement here and define its billing policy below."
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "options": "Project",
      "reqd": 1,
      "in_list_view": 1,
      "description": "The client job covered by these terms. Its customer must match the contract."
    },
    {
      "fieldname": "billing_model",
      "fieldtype": "Select",
      "label": "Billing Model",
      "options": "Daily\nFixed",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Daily: approved worker-days times the client rate. Fixed: approved milestones against the agreed amount. Worker wages stay separate in both models."
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "label": "Currency",
      "options": "Currency",
      "default": "PKR",
      "description": "Use the project company currency. This version does not convert contractor rates between currencies."
    },
    {
      "fieldname": "fixed_amount",
      "fieldtype": "Currency",
      "label": "Agreed Fixed Amount",
      "default": "0",
      "description": "Total agreed client contract value for Fixed billing. Approved milestones cannot exceed this value."
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nActive\nClosed",
      "default": "Draft",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Use Draft while agreeing terms. Active terms can be used for allocations and preparing client invoices. Closed terms stop new invoicing."
    },
    {
      "fieldname": "effective_start",
      "fieldtype": "Date",
      "label": "Start Date",
      "reqd": 1
    },
    {
      "fieldname": "effective_end",
      "fieldtype": "Date",
      "label": "End Date"
    },
    {
      "fieldname": "agreement_title",
      "label": "Agreement name",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "staffing",
      "label": "Agreed venues and worker categories",
      "fieldtype": "Table",
      "options": "PP Agreement Staffing"
    },
    {
      "fieldname": "billing_item",
      "label": "Invoice service item",
      "fieldtype": "Link",
      "options": "Item"
    },
    {
      "fieldname": "auto_invoice",
      "label": "Create invoice draft when a milestone is approved",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "validity_mode",
      "fieldtype": "Select",
      "label": "Agreement validity",
      "options": "\nFixed period\nOngoing",
      "default": ""
    },
    {
      "fieldname": "resource_mode",
      "fieldtype": "Select",
      "label": "Resource commitment",
      "options": "Fixed quantities\nEstimated quantities\nMinimum quantities\nRate card\nPer event",
      "default": "Fixed quantities"
    },
    {
      "fieldname": "rate_card",
      "fieldtype": "Long Text",
      "label": "Negotiated category rates",
      "hidden": 1
    },
    {
      "fieldname": "event_basis",
      "fieldtype": "Check",
      "label": "Event commercial snapshot",
      "default": "0",
      "hidden": 1,
      "read_only": 1
    },
    {
      "fieldname": "governing_agreement",
      "fieldtype": "Link",
      "label": "Governing agreement",
      "options": "PP Contract Terms",
      "read_only": 1
    },
    {
      "fieldname": "commercial_status",
      "fieldtype": "Select",
      "label": "Commercial confirmation",
      "options": "Pending\nConfirmed\nCompany attested",
      "default": "Pending"
    },
    {
      "fieldname": "commercial_source",
      "fieldtype": "Small Text",
      "label": "Confirmation source"
    },
    {
      "fieldname": "recurrence_note",
      "fieldtype": "Small Text",
      "label": "Future occurrences note"
    },
    {
      "fieldname": "commercial_snapshot",
      "fieldtype": "Long Text",
      "label": "Inherited commercial commitment",
      "hidden": 1,
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 0,
      "share": 0
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "show_title_field_in_link": 1,
  "search_fields": "agreement_title,project,billing_model,contract"
}
