{
  "doctype": "DocType",
  "name": "PP Work Entry",
  "module": "PLUS POINT",
  "custom": 0,
  "autoname": "hash",
  "title_field": "employee",
  "description": "Worker attendance and snapshotted daily wage/billing amount",
  "track_changes": 1,
  "allow_import": 1,
  "engine": "InnoDB",
  "is_submittable": 0,
  "field_order": [
    "assignment",
    "work_date",
    "units",
    "status",
    "employee",
    "site",
    "project",
    "contract_terms",
    "wage_rate",
    "client_rate",
    "wage_amount",
    "billable_amount",
    "remarks",
    "sales_invoice"
