      "label": "Assignment",
      "options": "PP Assignment",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "work_date",
      "fieldtype": "Date",
      "label": "Work Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "units",
      "fieldtype": "Float",
