    },
    {
      "fieldname": "employee",
      "fieldtype": "Link",
      "label": "Worker",
      "options": "Employee",
      "read_only": 1
    },
    {
      "fieldname": "site",
      "fieldtype": "Link",
      "label": "Site",
      "options": "PP Site",
      "read_only": 1
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "options": "Project",
      "read_only": 1
    },
    {
      "fieldname": "contract_terms",
      "fieldtype": "Link",
      "label": "Billing Terms",
      "options": "PP Contract Terms",
      "read_only": 1
    },
    {
      "fieldname": "wage_rate",
      "fieldtype": "Currency",
      "label": "Locked Wage Rate",
      "read_only": 1
    },
    {
      "fieldname": "client_rate",
      "fieldtype": "Currency",
      "label": "Locked Client Rate",
      "read_only": 1
    },
    {
      "fieldname": "wage_amount",
      "fieldtype": "Currency",
      "label": "Wage Accrued",
      "read_only": 1
    },
    {
      "fieldname": "billable_amount",
      "fieldtype": "Currency",
      "label": "Daily Client Billable",
      "read_only": 1
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "Notes"
