{
  "doctype": "DocType",
  "name": "PP Daily Register",
  "module": "PLUS POINT",
  "custom": 0,
  "autoname": "format:PP-REG-{work_date}-{#####}",
  "description": "Bulk daily site attendance using Frappe's standard form, table and Submit controls",
  "track_changes": 1,
  "is_submittable": 1,
  "engine": "InnoDB",
  "field_order": ["work_date", "site", "project", "entries", "notes"],
  "fields": [
    {"fieldname": "work_date", "fieldtype": "Date", "label": "Work Date", "reqd": 1, "in_list_view": 1},
    {"fieldname": "site", "fieldtype": "Link", "label": "Site", "options": "PP Site", "reqd": 1, "in_list_view": 1},
    {"fieldname": "project", "fieldtype": "Link", "label": "Project", "options": "Project", "read_only": 1},
    {"fieldname": "entries", "fieldtype": "Table", "label": "Worker Attendance", "options": "PP Register Line", "reqd": 1},
    {"fieldname": "notes", "fieldtype": "Small Text", "label": "Notes"}
  ],
  "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 0, "amend": 0, "report": 1, "export": 1, "print": 1}],
  "sort_field": "modified", "sort_order": "DESC"
}
